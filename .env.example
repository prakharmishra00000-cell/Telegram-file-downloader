# --- Telegram API Credentials (get from https://my.telegram.org/apps) ---
# These are per-user now (stored encrypted in DB), but can be set here as defaults
API_ID=12345678
API_HASH=1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- Paths ---
SESSION_PATH=sessions
DOWNLOAD_DIRECTORY=downloads
DATABASE_PATH=data/app.db
# PostgreSQL connection string (set on Render; leave empty for SQLite dev mode)
DATABASE_URL=

# --- Runtime ---
LOG_LEVEL=INFO
MAX_CONCURRENT_DOWNLOADS=5
HOST=0.0.0.0
PORT=8899

# --- Public URL (for CORS) ---
PUBLIC_URL=https://your-app.onrender.com

# --- SSL (optional, Render handles this automatically) ---
SSL_CERT=
SSL_KEY=
